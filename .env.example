PORT=3048
# 生产环境设为 1：会话 cookie 加 Secure
COOKIE_SECURE=0
# 数据库文件位置
DB_PATH=./data/arena.db
# 网站地址（重设密码邮件里的链接）
APP_URL=https://kaleido.quest
# 发信（找回密码）。不填 SMTP_PASS 时：本地开发把邮件打印到控制台；生产环境会提示「暂时无法发邮件」
SMTP_HOST=mail.visionchinese.com
SMTP_PORT=2525
SMTP_USER=noreply@visionchinese.com
SMTP_PASS=
MAIL_FROM=KaleidoQuest <noreply@visionchinese.com>
# 管理后台：这些邮箱注册的账号是管理员（逗号分隔）
ADMIN_EMAILS=
